const process = [
  {
    icon: 'message-square',
    title: 'Briefing & Konzept',
    desc: 'Wir besprechen, was du brauchst: Auflage, Format, Inhalt und Budget. Danach bekommst du ein klares Angebot.',
  },
  {
    icon: 'pen-tool',
    title: 'Design & Feinschliff',
    desc: 'Wir gestalten deine Drucksorten passend zu deiner Marke. Du gibst Feedback, wir verfeinern bis zur Freigabe.',
  },
  {
    icon: 'printer',
    title: 'Druck & Lieferung',
    desc: 'Wir bereiten die Druckdaten auf, beauftragen die passende Druckerei und liefern dir das fertige Ergebnis.',
  },
];

const faq = [
  {
    question: 'Was kosten Drucksorten in Graz?',
    answer:
      'Das hängt von Umfang, Auflage und Veredelung ab: Die Gestaltung von Visitenkarten startet im niedrigen dreistelligen Bereich, Flyer und Folder kalkulieren wir je nach Seitenanzahl, Kataloge und Broschüren projektbezogen. Im kostenlosen Erstgespräch bekommst du ein Angebot mit Fixpreis – inklusive Druckkosten.',
  },
  {
    question: 'Übernehmt ihr auch den Druck?',
    answer:
      'Ja. Wir gestalten nicht nur, sondern erledigen auf Wunsch die komplette Druckabwicklung: Druckdaten, Papierempfehlung, Druckerei-Auswahl und Qualitätskontrolle. Du bekommst am Ende fertige Drucksorten geliefert.',
  },
  {
    question: 'Wie schnell sind meine Drucksorten fertig?',
    answer:
      'Visitenkarten und Flyer sind je nach Feedbackrunden oft innerhalb von 1–2 Wochen gestaltet und gedruckt. Umfangreiche Kataloge oder Magazine brauchen je nach Seitenumfang mehrere Wochen. Bei dringenden Terminen sag uns Bescheid – Express ist oft möglich.',
  },
  {
    question: 'Ich habe noch kein Logo – geht das trotzdem?',
    answer:
      'Klar. Wenn du noch kein Corporate Design hast, entwickeln wir zuerst Logo und Grundgestaltung und bauen deine Drucksorten darauf auf. So passt am Ende alles zusammen – von der Visitenkarte bis zur Website.',
  },
];
