---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE } from '../lib/site';

/* Impressum – Daten von Philipp bestätigt (BRIEFING.md, Abschnitt 2 + 10). */
---

<Layout
  title="Impressum | ident-IT GmbH – Werbeagentur Graz"
  description="Impressum der ident-IT GmbH, Werbeagentur in Graz. Angaben gemäß § 5 ECG."
  noindex
>
  <section class="bg-base pt-32 pb-16 lg:pt-40 lg:pb-24">
    <div class="iIT_container max-w-3xl">
      <div class="mb-8">
        <Breadcrumb items={[{ label: 'Impressum' }]} />
      </div>
      <h1 class="mb-12 text-4xl font-extrabold text-white md:text-5xl">Impressum</h1>

      <div class="space-y-8">
        <div>
          <h2 class="mb-3 text-xl font-bold text-white">Angaben gemäß § 5 ECG</h2>
          <p class="leading-relaxed text-muted/80">
            <strong class="text-white">{SITE.legalName}</strong><br />
            {SITE.address.street}<br />
            {`${SITE.address.zip} ${SITE.address.city}`}<br />
            Österreich
          </p>
        </div>

        <div>
          <h2 class="mb-3 text-xl font-bold text-white">Kontakt</h2>
          <p class="leading-relaxed text-muted/80">
            Telefon: <a href={`tel:${SITE.phoneE164}`} class="text-accent hover:underline">{SITE.phoneDisplay}</a><br />
            E-Mail: <a href={`mailto:${SITE.email}`} class="text-accent hover:underline">{SITE.email}</a><br />
            Website: <a href={SITE.url} class="text-accent hover:underline">{SITE.url}</a>
          </p>
        </div>

        <div>
          <h2 class="mb-3 text-xl font-bold text-white">Firmenbuchdaten</h2>
          <p class="leading-relaxed text-muted/80">
            Firmenbuchnummer: {SITE.register.firmenbuch}<br />
            Firmenbuchgericht: {SITE.register.gericht}<br />
            UID-Nummer: {SITE.register.uid}<br />
            Unternehmensgegenstand: {SITE.register.gegenstand}
          </p>
        </div>

        <div>
          <h2 class="mb-3 text-xl font-bold text-white">Kammerzugehörigkeit</h2>
          <p class="leading-relaxed text-muted/80">
            Mitglied der {SITE.register.mitglied}<br />
            Aufsichtsbehörde: {SITE.register.aufsicht}
          </p>
        </div>

        <div>
          <h2 class="mb-3 text-xl font-bold text-white">Haftungsausschluss</h2>
          <p class="text-sm leading-relaxed text-muted/70">
            Die Inhalte dieser Website wurden mit größter Sorgfalt erstellt. Für die Richtigkeit, Vollständigkeit und
            Aktualität der Inhalte können wir jedoch keine Gewähr übernehmen. Als Diensteanbieter sind wir gemäß § 7
            Abs. 1 ECG für eigene Inhalte auf diesen Seiten nach den allgemeinen Gesetzen verantwortlich. Wir sind
            jedoch nicht verpflichtet, übermittelte oder gespeicherte fremde Informationen zu überwachen oder nach
            Umständen zu forschen, die auf eine rechtswidrige Tätigkeit hinweisen.
          </p>
        </div>

        <div>
          <h2 class="mb-3 text-xl font-bold text-white">Urheberrecht</h2>
          <p class="text-sm leading-relaxed text-muted/70">
            Die durch die Seitenbetreiber erstellten Inhalte und Werke auf diesen Seiten unterliegen dem
            österreichischen Urheberrecht. Die Vervielfältigung, Bearbeitung, Verbreitung und jede Art der Verwertung
            außerhalb der Grenzen des Urheberrechtes bedürfen der schriftlichen Zustimmung des jeweiligen Autors bzw.
            Erstellers.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
