---
import { SITE } from '../lib/site';

// Breadcrumb: UI + BreadcrumbList-JSON-LD (BRIEFING.md, Abschnitt 7).
// Verwendung: <Breadcrumb items={[{ label: 'Leistungen', href: '/leistungen/' }, { label: 'SEO' }]} />
// Die Startseite wird automatisch vorangestellt; das letzte Element ist die aktuelle Seite.
export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const crumbs: Crumb[] = [{ label: 'Startseite', href: '/' }, ...items];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.label,
    ...(crumb.href ? { item: new URL(crumb.href, SITE.url).href } : {}),
  })),
};
---

<nav aria-label="Breadcrumb" class="text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-2">
    {
      crumbs.map((crumb, index) => (
        <li class="flex items-center gap-2">
          {index > 0 && (
            <span aria-hidden="true" class="opacity-50">
              /
            </span>
          )}
          {crumb.href && index < crumbs.length - 1 ? (
            <a href={crumb.href} class="transition-colors hover:text-accent-light">
              {crumb.label}
            </a>
          ) : (
            <span aria-current="page" class="text-ink">
              {crumb.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
