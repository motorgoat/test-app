---
import Logo from './Logo.astro';
import { SITE, SERVICE_LINKS } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-steel/10 bg-section">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href="/" aria-label={`${SITE.name} – zur Startseite`}>
        <Logo class="text-2xl" />
      </a>
      <p class="mt-3 font-display font-extrabold tracking-wide text-steel">{SITE.slogan}</p>
      <a
        href={SITE.rating.url}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-flex items-center gap-2 rounded-lg text-sm text-ink transition-colors hover:text-teal-light"
      >
        <span class="text-teal-light" aria-hidden="true">★★★★★</span>
        <span>{SITE.rating.value} bei Google ({SITE.rating.count} Bewertungen)</span>
      </a>
    </div>

    <div>
      <h2 class="text-sm font-bold tracking-wider text-steel uppercase">Kontakt</h2>
      <address class="mt-4 space-y-2 text-sm not-italic">
        <p>
          {SITE.legalName}<br />
          {SITE.address.street}<br />
          {SITE.address.zip} {SITE.address.city}
        </p>
        <p>
          <a href={`tel:${SITE.phoneE164}`} class="transition-colors hover:text-teal-light">
            {SITE.phoneDisplay}
          </a>
          <br />
          <a href={`mailto:${SITE.email}`} class="transition-colors hover:text-teal-light">
            {SITE.email}
          </a>
        </p>
      </address>
      <h2 class="mt-6 text-sm font-bold tracking-wider text-steel uppercase">Öffnungszeiten</h2>
      <ul class="mt-3 space-y-1 text-sm">
        {
          SITE.openingHours.map((slot) => (
            <li>
              {slot.label}: {slot.value}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="lg:col-span-2">
      <h2 class="text-sm font-bold tracking-wider text-steel uppercase">Leistungen</h2>
      <ul class="mt-4 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
        {
          SERVICE_LINKS.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-teal-light">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-steel/10">
    <div
      class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 px-4 py-5 text-sm text-steel sm:px-6 md:flex-row"
    >
      <p>© {year} {SITE.legalName} · Werbeagentur Graz</p>
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <li><a href="/impressum/" class="transition-colors hover:text-teal-light">Impressum</a></li>
        <li><a href="/datenschutz/" class="transition-colors hover:text-teal-light">Datenschutz</a></li>
        <li><a href="/agb/" class="transition-colors hover:text-teal-light">AGB</a></li>
        <li>
          {/* Öffnet das CCM19-Widget – Einbindung folgt im Tracking-Schritt */}
          <button type="button" class="iIT_ccm-trigger cursor-pointer transition-colors hover:text-teal-light">
            Cookie-Einstellungen
          </button>
        </li>
      </ul>
    </div>
  </div>
</footer>
