---
import { Image } from 'astro:assets';
import logoMark from '../assets/logo-mark.png';

// Logo: freigestelltes Symbol aus Philipps Vorlage + Wortmarke.
// Sobald das finale Logo als SVG vorliegt, hier nur das Symbol/SVG tauschen –
// alle Verwendungen (Header, Footer) ziehen automatisch nach.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class={`iIT_logo inline-flex items-center gap-2.5 ${className}`}>
  <Image src={logoMark} alt="" width={88} densities={[1, 2]} class="h-9 w-auto" loading="eager" />
  <span class="font-display text-xl font-extrabold tracking-tight">
    ident-<span class="iIT_gradient-text">IT</span>
  </span>
</span>
