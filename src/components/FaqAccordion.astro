---
// FAQ-Accordion mit FAQPage-Schema (BRIEFING.md, Abschnitte 6 + 7).
// Verwendung: <FaqAccordion items={[{ question: '…', answer: '…' }]} />
// answer ist reiner Text (kein HTML) – so bleibt das Schema konsistent zur UI.
export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<div class="space-y-3">
  {
    items.map((item) => (
      <details class="iIT_neu-card group">
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-display font-bold [&::-webkit-details-marker]:hidden">
          {item.question}
          <svg
            viewBox="0 0 20 20"
            width="18"
            height="18"
            fill="currentColor"
            aria-hidden="true"
            class="shrink-0 text-teal-light transition-transform group-open:rotate-180"
          >
            <path
              fill-rule="evenodd"
              d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.06l3.71-3.83a.75.75 0 1 1 1.08 1.04l-4.25 4.39a.75.75 0 0 1-1.08 0L5.21 8.27a.75.75 0 0 1 .02-1.06Z"
              clip-rule="evenodd"
            />
          </svg>
        </summary>
        <p class="px-5 pb-5 text-steel">{item.answer}</p>
      </details>
    ))
  }
</div>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
