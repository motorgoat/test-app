---
import Icon from './Icon.astro';

// FAQ-Accordion mit FAQPage-Schema (BRIEFING.md, Abschnitte 6 + 7).
// Look aus dem Entwurf: Neu-Raised-Summary, rotierendes Fragezeichen-Icon.
// answer ist reiner Text (kein HTML) – so bleibt das Schema konsistent zur UI.
export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<div class="space-y-4">
  {
    items.map((item) => (
      <details class="group">
        <summary class="iIT_neu-raised flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 rounded-xl bg-card p-5 [&::-webkit-details-marker]:hidden">
          <span class="text-left font-semibold text-white">{item.question}</span>
          <Icon
            name="circle-help"
            size={20}
            class="shrink-0 text-accent transition-transform duration-300 group-open:rotate-180"
          />
        </summary>
        <p class="px-5 pt-3 pb-5 leading-relaxed text-muted/80">{item.answer}</p>
      </details>
    ))
  }
</div>

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
