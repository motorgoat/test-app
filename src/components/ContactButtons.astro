---
import Icon from './Icon.astro';

// Schnellkontakt rechts unten als aufklappbarer FAB: Ein Haupt-Button,
// beim Antippen erscheinen Telefon, E-Mail und WhatsApp – alle drei im
// einheitlichen Look. Ohne JS sind die drei Buttons dauerhaft sichtbar.
// Tel-/Mail-/WhatsApp-Klicks werden später als GTM-Events getaggt (Abschnitt 9).
interface Props {
  waText?: string;
}
const { waText = 'Hallo, ich habe eine Frage zu ' } = Astro.props;
const phone = '436609449688';
const mail = 'office@ident-it.at';
const text = encodeURIComponent(waText);
---

<nav class="iIT_contact-fab" aria-label="Schnellkontakt">
  <div id="iIT_fab-actions" class="iIT_fab-actions">
    <a href={`tel:+${phone}`} class="iIT_fab-btn" aria-label="Jetzt anrufen">
      <Icon name="phone" size={22} />
    </a>
    <a href={`mailto:${mail}`} class="iIT_fab-btn" aria-label="E-Mail schreiben">
      <Icon name="mail" size={22} />
    </a>
    <a
      href={`https://wa.me/${phone}?text=${text}`}
      target="_blank"
      rel="noopener noreferrer"
      class="iIT_fab-btn"
      aria-label="Kontakt über WhatsApp"
    >
      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 0 1 6.988 2.896 9.82 9.82 0 0 1 2.892 6.994c-.003 5.45-4.437 9.885-9.884 9.885M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.359.101 11.947c0 2.096.549 4.142 1.588 5.945L0 24l6.335-1.652a11.9 11.9 0 0 0 5.71 1.454h.006c6.585 0 11.946-5.359 11.949-11.948 0-3.192-1.24-6.192-3.495-8.445"
        ></path>
      </svg>
    </a>
  </div>

  <button
    type="button"
    id="iIT_fab-toggle"
    class="iIT_fab-toggle"
    aria-expanded="false"
    aria-controls="iIT_fab-actions"
    aria-label="Schnellkontakt öffnen"
  >
    <span class="iIT_fab-icon iIT_fab-icon--open"><Icon name="message-circle" size={26} /></span>
    <span class="iIT_fab-icon iIT_fab-icon--close"><Icon name="x" size={26} /></span>
  </button>
</nav>

<style>
  .iIT_contact-fab {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 999;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  /* Haupt-Button im Marken-Verlauf */
  .iIT_fab-toggle {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: none;
    background: var(--iIT-gradient-button);
    color: #0d1117;
    cursor: pointer;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.35);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .iIT_fab-toggle:hover {
    transform: scale(1.07);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.45);
  }
  .iIT_fab-icon {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }
  .iIT_fab-icon--close {
    opacity: 0;
    transform: rotate(-90deg);
  }
  .iIT_open .iIT_fab-icon--open {
    opacity: 0;
    transform: rotate(90deg);
  }
  .iIT_open .iIT_fab-icon--close {
    opacity: 1;
    transform: rotate(0deg);
  }

  /* Aktionen: einheitlicher Look für alle drei Kontaktwege */
  .iIT_fab-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .iIT_fab-btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-card);
    border: 1px solid rgb(255 255 255 / 0.1);
    color: var(--color-accent);
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.35);
    transition:
      transform 0.15s ease,
      opacity 0.2s ease,
      border-color 0.15s ease;
  }
  .iIT_fab-btn:hover {
    transform: scale(1.07);
    border-color: rgb(0 180 168 / 0.5);
  }

  /* Zugeklappt: unsichtbar und nicht fokussierbar – nur wenn JS aktiv ist */
  html.iIT_js .iIT_fab-actions .iIT_fab-btn {
    opacity: 0;
    transform: translateY(10px);
    visibility: hidden;
    pointer-events: none;
  }
  html.iIT_js .iIT_open .iIT_fab-actions .iIT_fab-btn {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
    pointer-events: auto;
  }
  /* Gestaffeltes Aufklappen von unten nach oben */
  html.iIT_js .iIT_open .iIT_fab-actions .iIT_fab-btn:nth-child(3) {
    transition-delay: 0ms;
  }
  html.iIT_js .iIT_open .iIT_fab-actions .iIT_fab-btn:nth-child(2) {
    transition-delay: 50ms;
  }
  html.iIT_js .iIT_open .iIT_fab-actions .iIT_fab-btn:nth-child(1) {
    transition-delay: 100ms;
  }

  @media (max-width: 380px) {
    .iIT_fab-toggle {
      width: 52px;
      height: 52px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .iIT_fab-toggle,
    .iIT_fab-btn,
    .iIT_fab-icon {
      transition: none;
    }
  }
</style>

<script>
  const fab = document.querySelector('.iIT_contact-fab');
  const toggle = document.getElementById('iIT_fab-toggle');

  const setOpen = (open: boolean) => {
    fab?.classList.toggle('iIT_open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Schnellkontakt schließen' : 'Schnellkontakt öffnen');
  };

  toggle?.addEventListener('click', () => {
    setOpen(!fab?.classList.contains('iIT_open'));
  });

  // Klick außerhalb oder Escape schließt das Menü
  document.addEventListener('click', (event) => {
    if (fab?.classList.contains('iIT_open') && event.target instanceof Node && !fab.contains(event.target)) {
      setOpen(false);
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && fab?.classList.contains('iIT_open')) {
      setOpen(false);
      (toggle as HTMLElement | null)?.focus();
    }
  });
</script>
