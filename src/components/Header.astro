---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, SITE } from '../lib/site';
---

<header id="iIT_header" class="iIT_header fixed top-0 right-0 left-0 z-50">
  <div class="iIT_container flex items-center justify-between gap-6 py-3">
    <a href="/" class="shrink-0" aria-label={`${SITE.name} – zur Startseite`}>
      <Logo />
    </a>

    {/* Desktop-Navigation mit Dropdowns (Hover + Tastatur via focus-within) */}
    <nav class="hidden lg:block" aria-label="Hauptnavigation">
      <ul class="flex items-center gap-1">
        {
          NAV.map((item) => (
            <li class="iIT_nav-item relative">
              <a
                href={item.href}
                class="text-ink flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium transition-colors hover:text-accent-light"
              >
                {item.label}
                {item.children && <Icon name="chevron-down" size={14} class="iIT_nav-chevron opacity-60" />}
              </a>
              {item.children && (
                <ul class="iIT_dropdown absolute top-full left-0 w-80 rounded-xl border border-white/[0.08] bg-card/95 p-2 shadow-2xl shadow-black/30 backdrop-blur-2xl">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} class="block rounded-lg px-4 py-3 transition-all hover:bg-accent/10">
                        <span class="text-ink block text-sm font-medium">{child.label}</span>
                        <span class="text-muted block text-xs">{child.description}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      {/* Tel-CTA wie im Entwurf – auf Mobil als kompakter Icon-Button fix sichtbar */}
      <a
        href={`tel:${SITE.phoneE164}`}
        class="iIT_neu-clickable relative hidden items-center gap-2 overflow-hidden rounded-lg px-5 py-2.5 text-sm font-bold text-[#0d1117] md:flex"
        style="background: var(--iIT-gradient-button); border: none;"
      >
        <span
          class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/20 to-transparent transition-transform duration-700 hover:translate-x-full"
          aria-hidden="true"></span>
        <Icon name="phone" size={16} class="relative z-10" />
        <span class="relative z-10">Jetzt anrufen</span>
      </a>
      <a
        href={`tel:${SITE.phoneE164}`}
        class="grid h-11 w-11 place-items-center rounded-lg text-[#0d1117] md:hidden"
        style="background: var(--iIT-gradient-button);"
        aria-label="Jetzt anrufen"
      >
        <Icon name="phone" size={20} />
      </a>

      {/* Burger (mobil) */}
      <button
        type="button"
        id="iIT_burger"
        class="text-ink grid h-11 w-11 place-items-center rounded-lg border border-muted/20 lg:hidden"
        aria-expanded="false"
        aria-controls="iIT_mobile-nav"
        aria-label="Menü öffnen"
      >
        <span class="iIT_burger-open"><Icon name="menu" size={22} /></span>
        <span class="iIT_burger-close hidden"><Icon name="x" size={22} /></span>
      </button>
    </div>
  </div>

  {/* Mobile Navigation: Accordion-Untermenüs, Kontakt-CTA fix sichtbar */}
  <nav
    id="iIT_mobile-nav"
    class="hidden max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-muted/10 bg-base/95 backdrop-blur-2xl lg:hidden"
    aria-label="Hauptnavigation mobil"
  >
    <div class="iIT_container space-y-1 py-4">
      {
        NAV.map((item) =>
          item.children ? (
            <details class="group rounded-lg">
              <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2.5 font-medium [&::-webkit-details-marker]:hidden">
                {item.label}
                <Icon name="chevron-down" size={16} class="transition-transform group-open:rotate-180" />
              </summary>
              <ul class="space-y-1 pb-2 pl-3">
                <li>
                  <a href={item.href} class="text-muted block min-h-11 rounded-lg px-3 py-2.5 hover:text-accent-light">
                    {item.label} – Übersicht
                  </a>
                </li>
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} class="text-muted block min-h-11 rounded-lg px-3 py-2.5 hover:text-accent-light">
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ) : (
            <a href={item.href} class="block min-h-11 rounded-lg px-3 py-2.5 font-medium">
              {item.label}
            </a>
          )
        )
      }
      <div class="pt-3">
        <a href="/kontakt/" class="iIT_btn iIT_btn--md iIT_btn--primary w-full">
          <span class="iIT_btn-shine" aria-hidden="true"></span>
          <span class="relative z-10">Kostenloses Erstgespräch</span>
        </a>
      </div>
    </div>
  </nav>
</header>

<style>
  /* Transparent über dem Hero, solide + Blur beim Scrollen (Entwurfs-Verhalten) */
  .iIT_header {
    background: transparent;
    transition:
      background-color 0.5s ease,
      box-shadow 0.5s ease,
      border-color 0.5s ease;
    border-bottom: 1px solid transparent;
  }
  .iIT_header.iIT_scrolled {
    background: rgb(13 17 23 / 0.85);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom-color: rgb(255 255 255 / 0.05);
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.2);
  }
  /* Sobald das Mobile-Menü offen ist, braucht der Header ebenfalls Hintergrund */
  .iIT_header:has(#iIT_mobile-nav:not(.hidden)) {
    background: rgb(13 17 23 / 0.95);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
  }

  /* Dropdown: unsichtbar, aber öffnet bei Hover/Tastatur-Fokus */
  .iIT_dropdown {
    visibility: hidden;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      visibility 0.15s;
  }
  .iIT_nav-item:hover .iIT_dropdown,
  .iIT_nav-item:focus-within .iIT_dropdown {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .iIT_header,
    .iIT_dropdown {
      transition: none;
    }
  }
</style>

<script>
  // Burger-Menü: Panel ein-/ausblenden, Zustand für Screenreader spiegeln.
  const burger = document.getElementById('iIT_burger');
  const panel = document.getElementById('iIT_mobile-nav');

  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    burger.setAttribute('aria-label', open ? 'Menü öffnen' : 'Menü schließen');
    panel?.classList.toggle('hidden', open);
    burger.querySelector('.iIT_burger-open')?.classList.toggle('hidden', !open);
    burger.querySelector('.iIT_burger-close')?.classList.toggle('hidden', open);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && burger?.getAttribute('aria-expanded') === 'true') {
      burger.click();
      burger.focus();
    }
  });
</script>
