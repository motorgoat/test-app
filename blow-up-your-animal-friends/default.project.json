{
  "name": "blow-up-your-animal-friends",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": false
      },
      "FileSpawnBeacon": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [12, 1, 12],
          "Position": [0, 40, 0],
          "Color": [0.2, 0.55, 1.0],
          "Material": "Neon",
          "Duration": 0,
          "Neutral": true
        }
      },
      "PlayFieldWallFront": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Size": [1024, 512, 2],
          "Position": [0, 128, -15],
          "Transparency": 1,
          "CanCollide": true,
          "CanQuery": false,
          "CanTouch": false,
          "CastShadow": false,
          "Locked": true
        }
      },
      "PlayFieldWallBack": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Size": [1024, 512, 2],
          "Position": [0, 128, 15],
          "Transparency": 1,
          "CanCollide": true,
          "CanQuery": false,
          "CanTouch": false,
          "CastShadow": false,
          "Locked": true
        }
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      },
      "Remotes": {
        "$className": "Folder",
        "FireRequest": { "$className": "RemoteEvent" },
        "ProjectileFired": { "$className": "RemoteEvent" },
        "ProjectileImpact": { "$className": "RemoteEvent" },
        "WeaponSelect": { "$className": "RemoteEvent" },
        "MatchEvent": { "$className": "RemoteEvent" },
        "QuipEvent": { "$className": "RemoteEvent" },
        "CameraCue": { "$className": "RemoteEvent" },
        "DamageEvent": { "$className": "RemoteEvent" }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/ServerScriptService"
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "src/StarterPlayer/StarterPlayerScripts"
      }
    }
  }
}
