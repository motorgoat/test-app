---
import { existsSync } from 'node:fs';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  // false bei Seiten ohne großes Bild oben (z. B. Impressum)
  heroHeader?: boolean;
}

const { title, description = site.description, noindex = false, heroHeader = true } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} – ${site.claim}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Vorschaubild für Social Media / Messenger: Datei public/og-image.jpg (1200 × 630 px).
// Solange sie fehlt, wird kein og:image ausgegeben.
const ogImage = existsSync('public/og-image.jpg') ? new URL('/og-image.jpg', Astro.site) : undefined;

// Strukturierte Daten für Suchmaschinen (Adresse, Telefon …) – kommen aus src/data/site.ts
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.legalName.replace(/\u00A0/g, ' '),
  url: site.url,
  email: site.email,
  telephone: site.phone.replace(/\s/g, ''),
  foundingDate: String(site.founded),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.zip,
    addressLocality: site.address.city,
    addressCountry: 'AT',
  },
};
---

<!doctype html>
<html lang="de-AT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#112236" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_AT" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <Header overlay={heroHeader} />
    <main id="main" class:list={{ 'no-hero': !heroHeader }}>
      <slot />
    </main>
    <Footer />

    <script>
      // Elemente mit data-reveal beim Scrollen sanft einblenden
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      items.forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .no-hero {
    padding-top: 4.5rem;
  }
</style>
