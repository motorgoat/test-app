---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ContactCta from '@/components/ContactCta.astro';
import { getProjekte } from '@/lib/projekte';

const projekte = await getProjekte();
const kategorien = [...new Set(projekte.map((p) => p.data.kategorie))];
---

<BaseLayout
  title="Projekte"
  description="Ausgewählte Projekte von CONSERVE: bauhistorische Untersuchungen, Fassadenuntersuchungen, Fensterrenovierungen und örtliche Bauaufsicht."
>
  <PageHero
    eyebrow="Projekte"
    title="Referenzen aus Bauforschung und Altbausanierung"
    lead="Eine Auswahl unserer Projekte – von Schlössern und Stadtpalais bis zu Bürgerhäusern und Kapellen."
  />

  <section class="section">
    <div class="container">
      {
        kategorien.length > 1 && (
          <div class="filter" role="group" aria-label="Nach Kategorie filtern" data-filter>
            <button type="button" aria-pressed="true" data-value="">
              Alle
            </button>
            {kategorien.map((k) => (
              <button type="button" aria-pressed="false" data-value={k}>
                {k}
              </button>
            ))}
          </div>
        )
      }
      <div class="card-grid">
        {
          projekte.map((p) => (
            <div data-kategorie={p.data.kategorie}>
              <ProjectCard project={p} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>

<script>
  const filter = document.querySelector<HTMLElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-kategorie]');

  filter?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!btn) return;
    const value = btn.dataset.value;
    filter.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    items.forEach((el) => {
      el.hidden = Boolean(value) && el.dataset.kategorie !== value;
    });
  });
</script>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--space-l);
  }

  .filter button {
    padding: 0.45em 1em;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    background: transparent;
    color: var(--c-ink);
    font: inherit;
    font-size: var(--fs-sm);
    cursor: pointer;
  }

  .filter button[aria-pressed='true'] {
    background: var(--c-ink);
    border-color: var(--c-ink);
    color: var(--c-bg);
  }
</style>
