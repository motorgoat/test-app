---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactCta from '@/components/ContactCta.astro';
import ImagePlaceholder from '@/components/ImagePlaceholder.astro';
import { getProjekte } from '@/lib/projekte';

export async function getStaticPaths() {
  const projekte = await getProjekte();
  return projekte.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: projekte[i - 1], next: projekte[i + 1] },
  }));
}

const { project, prev, next } = Astro.props;
const { title, ort, jahr, leistung, kategorie, auftraggeber, bild, bildAlt } = project.data;
const { Content } = await render(project);
const hasBody = Boolean(project.body?.trim());

const facts = [
  { label: 'Ort', value: ort },
  { label: 'Jahr', value: jahr },
  { label: 'Leistung', value: leistung },
  { label: 'Kategorie', value: kategorie },
  { label: 'Auftraggeber', value: auftraggeber },
].filter((f) => f.value);
---

<BaseLayout title={`${title}, ${ort}`} description={`${leistung} – ${title}, ${ort}. Ein Projekt von CONSERVE.`}>
  <article>
    <header class="section project-head">
      <div class="container">
        <a href="/projekte" class="back">← Alle Projekte</a>
        <span class="eyebrow">{ort}{jahr && ` · ${jahr}`}</span>
        <h1>{title}</h1>
        <p class="lead">{leistung}</p>
      </div>
    </header>

    <div class="container media">
      {
        bild ? (
          <Image src={bild} alt={bildAlt ?? title} widths={[800, 1600]} sizes="100vw" loading="eager" />
        ) : (
          <ImagePlaceholder label={title} ratio="16 / 9" />
        )
      }
    </div>

    <section class="section">
      <div class="container layout">
        <dl class="facts">
          {
            facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
        <div class="prose">
          {hasBody ? <Content /> : <p class="lead">Die Projektbeschreibung folgt in Kürze.</p>}
        </div>
      </div>
    </section>

    <nav class="container pager" aria-label="Weitere Projekte">
      {prev ? <a href={`/projekte/${prev.id}`}>← {prev.data.title}</a> : <span />}
      {next && <a href={`/projekte/${next.id}`}>{next.data.title} →</a>}
    </nav>
  </article>

  <ContactCta />
</BaseLayout>

<style>
  .project-head {
    padding-bottom: var(--space-l);
  }

  .back {
    display: inline-block;
    margin-bottom: var(--space-l);
    font-size: var(--fs-sm);
    text-decoration: none;
  }

  .back + .eyebrow {
    display: block;
  }

  .media :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .layout {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 56rem) {
    .layout {
      grid-template-columns: 18rem 1fr;
      gap: var(--space-xl);
    }
  }

  .facts {
    margin: 0;
  }

  .facts div {
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--c-line);
  }

  .facts div:first-child {
    border-top: 1px solid var(--c-ink);
  }

  dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-ink-soft);
  }

  dd {
    margin: 0.15rem 0 0;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--space-m);
    padding-bottom: var(--space-xl);
  }

  .pager a {
    font-family: var(--f-serif);
    font-size: var(--fs-lg);
    text-decoration: none;
  }
</style>
