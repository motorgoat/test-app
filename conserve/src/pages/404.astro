---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
---

<BaseLayout title="Seite nicht gefunden" noindex>
  <PageHero
    eyebrow="Fehler 404"
    title="Diese Seite gibt es nicht (mehr)."
    lead="Möglicherweise wurde sie verschoben. Über die Navigation finden Sie alle Inhalte."
  >
    <p style="margin-top: var(--space-l)">
      <a class="btn" href="/">Zur Startseite</a>
    </p>
  </PageHero>
</BaseLayout>
