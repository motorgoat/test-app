---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Bild from '@/components/Bild.astro';
import { leistungen } from '@/data/leistungen';
---

<BaseLayout
  title="Leistungen"
  description="Bauforschung, Gebäudedokumentation & Gutachten, Fachbegleitung im Denkmalschutz und Altbausanierung (ÖBA) – von der bauhistorischen Untersuchung bis zur örtlichen Bauaufsicht."
>
  <Hero
    eyebrow="Leistungen"
    title="Fundierte Voruntersuchung.<br />Sichere Planung.<br />Nachhaltige Entscheidungen."
    bild="hero-leistungen.jpg"
  />

  <section class="section">
    <div class="container container--narrow center" data-reveal>
      <h2>Spezialisiert auf Weltkulturerbe, Denkmalschutz und Altbau</h2>
      <p class="lead">
        Maßgeschneiderte Lösungen für den Erhalt historischer Gebäude – von der Bauforschung über Dokumentation,
        Gutachten und Fachbegleitung bis zur örtlichen Bauaufsicht.
      </p>
      <nav class="toc" aria-label="Leistungsbereiche">
        {leistungen.map((l) => <a href={`#${l.id}`}>{l.title}</a>)}
      </nav>
    </div>
  </section>

  {
    leistungen.map((bereich, i) => (
      <section id={bereich.id} class:list={['bereich', { 'bereich--reverse': i % 2 === 1 }]}>
        <div class="bereich__media">
          <Bild
            src={bereich.bild}
            alt={bereich.bildAlt ?? ''}
            position={bereich.bildPosition}
            sizes="(min-width: 64rem) 95vw, 100vw"
          />
        </div>
        <div class="bereich__text" data-reveal>
          <span class="eyebrow">{String(i + 1).padStart(2, '0')}</span>
          <h2>{bereich.title}</h2>
          <p class="lead">{bereich.intro}</p>
          <ul class="list">
            {bereich.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="section section--slate">
    <div class="container container--narrow center" data-reveal>
      <p class="statement">Sprechen wir über Ihr Gebäude.</p>
      <a class="btn btn--light" href="/kontakt/">Kontakt aufnehmen</a>
    </div>
  </section>
</BaseLayout>

<style>
  .toc {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }

  .toc a {
    padding: 0.6em 1.2em;
    border: 1px solid var(--c-line);
    font-size: var(--fs-sm);
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }

  .toc a:hover {
    border-color: var(--c-ink);
  }

  .bereich {
    display: grid;
    border-top: 1px solid var(--c-line);
  }

  @media (min-width: 64rem) {
    .bereich {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      min-height: 42rem;
    }

    .bereich--reverse .bereich__media {
      order: 2;
    }
  }

  .bereich__media {
    position: relative;
    min-height: 22rem;
  }

  .bereich__media :global(.bild) {
    position: absolute;
    inset: 0;
  }

  /* Textspalte: feste Lesebreite, liegt immer direkt am Bild an */
  .bereich__text {
    box-sizing: content-box;
    align-self: center;
    max-width: 32rem;
    padding: var(--space-xl) var(--gutter);
  }

  .bereich__text h2 {
    font-size: clamp(1.5rem, 0.9rem + 1.6vw, 2.5rem);
  }

  @media (min-width: 64rem) {
    .bereich__text {
      justify-self: start;
      padding-inline: clamp(2.5rem, 5vw, 5rem);
    }

    .bereich--reverse .bereich__text {
      justify-self: end;
    }
  }

  .bereich__text .lead {
    margin-bottom: var(--space-l);
  }
</style>
