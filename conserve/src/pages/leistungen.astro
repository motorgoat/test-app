---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Bild from '@/components/Bild.astro';
import { leistungen } from '@/data/leistungen';
---

<BaseLayout
  title="Leistungen"
  description="Dokumentation & Beratung, Bauforschung und Altbausanierung – von der bauhistorischen Untersuchung bis zur örtlichen Bauaufsicht."
>
  <Hero
    eyebrow="Leistungen"
    title="Fundierte Vor&shy;untersuchung. Sichere Planung. Nachhaltige Ent&shy;scheidungen."
    bild="hero-leistungen.jpg"
    bildAlt="Dachstuhl eines historischen Gebäudes"
  />

  <section class="section">
    <div class="container container--narrow center" data-reveal>
      <h2>Spezialisiert auf Weltkulturerbe, Denkmalschutz und Altbau</h2>
      <p class="lead">
        Maßgeschneiderte Lösungen für den Erhalt historischer Gebäude – von der Dokumentation über die Bauforschung bis
        zur Sanierung und örtlichen Bauaufsicht.
      </p>
      <nav class="toc" aria-label="Leistungsbereiche">
        {leistungen.map((l) => <a href={`#${l.id}`}>{l.title}</a>)}
      </nav>
    </div>
  </section>

  {
    leistungen.map((bereich, i) => (
      <section id={bereich.id} class:list={['bereich', { 'bereich--reverse': i % 2 === 1 }]}>
        <div class="bereich__media">
          <Bild src={bereich.bild} alt={bereich.title} sizes="(min-width: 64rem) 50vw, 100vw" />
        </div>
        <div class="bereich__text" data-reveal>
          <span class="eyebrow">{String(i + 1).padStart(2, '0')}</span>
          <h2>{bereich.title}</h2>
          <p class="lead">{bereich.intro}</p>
          <ul class="list">
            {bereich.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="section section--slate">
    <div class="container container--narrow center" data-reveal>
      <p class="statement">Sprechen wir über Ihr Gebäude.</p>
      <a class="btn btn--light" href="/kontakt">Kontakt aufnehmen</a>
    </div>
  </section>
</BaseLayout>

<style>
  .toc {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }

  .toc a {
    padding: 0.6em 1.2em;
    border: 1px solid var(--c-line);
    font-size: var(--fs-sm);
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }

  .toc a:hover {
    border-color: var(--c-ink);
  }

  .bereich {
    display: grid;
    border-top: 1px solid var(--c-line);
  }

  @media (min-width: 64rem) {
    .bereich {
      grid-template-columns: 1fr 1fr;
      min-height: 42rem;
    }

    .bereich--reverse .bereich__media {
      order: 2;
    }
  }

  .bereich__media {
    position: relative;
    min-height: 22rem;
  }

  .bereich__media :global(.bild) {
    position: absolute;
    inset: 0;
  }

  .bereich__text {
    align-self: center;
    max-width: 38rem;
    padding: var(--space-xl) var(--gutter);
  }

  @media (min-width: 64rem) {
    .bereich__text {
      padding-inline: var(--space-xl);
    }
  }

  .bereich__text .lead {
    margin-bottom: var(--space-l);
  }
</style>
