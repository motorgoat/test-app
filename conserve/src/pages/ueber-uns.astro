---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Bild from '@/components/Bild.astro';
import { site, team, telHref } from '@/data/site';
---

<BaseLayout
  title="Über uns"
  description={`${site.legalName} – seit ${site.founded} widmen wir uns der Erforschung, Bewertung und Weiterentwicklung von Baudenkmälern und Bestandsgebäuden.`}
>
  <Hero
    eyebrow="Über uns"
    title="Verantwortung für historische Bausubstanz"
    bild="hero-ueber-uns.jpg"
    bildAlt="Historische Fassade im Detail"
  />

  <section class="section">
    <div class="container container--narrow center" data-reveal>
      <span class="eyebrow">Seit {site.founded}</span>
      <h2>Die CONSERVE steht für den verantwortungs&shy;vollen Umgang mit historischer Bausubstanz.</h2>
      <p class="lead">
        Seit der Gründung im Jahr {site.founded} widmen wir uns der Erforschung, Bewertung und Weiterentwicklung von
        Baudenkmälern und Bestandsgebäuden. Unser Ziel ist es, die Qualitäten eines Gebäudes sichtbar zu machen und
        daraus tragfähige Grundlagen für Planung, Sanierung und Erhaltung zu entwickeln.
      </p>
    </div>
  </section>

  <section class="split">
    <div class="split__media">
      <Bild src="ueber-uns-arbeitsweise.jpg" alt="Bauforschung am Objekt" sizes="(min-width: 64rem) 50vw, 100vw" />
    </div>
    <div class="split__text" data-reveal>
      <span class="eyebrow">Arbeitsweise</span>
      <h2>Forschung, Expertise und Planung aus einer Hand</h2>
      <p>
        Als spezialisiertes Baumeister- und Planungsbüro verbinden wir bauhistorische Forschung, denkmalpflegerische
        Expertise und praktische Sanierungsplanung.
      </p>
      <p>
        Wir betrachten jedes Gebäude in seiner Geschichte, Konstruktion, Materialität und Nutzung. So entstehen
        Lösungen, die den Bestand respektieren, Ressourcen schonen und Gebäude zukunftsfähig machen.
      </p>
      <a class="btn" href="/leistungen">Unsere Leistungen</a>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="team__head" data-reveal>
        <span class="eyebrow">Team</span>
        <h2>Ihre Ansprechpartnerinnen</h2>
      </div>
      <ul class="team">
        {
          team.map((p) => (
            <li class="person" data-reveal>
              <h3>{p.name}</h3>
              {p.role && <p class="person__role">{p.role}</p>}
              <a href={telHref(p.phone)}>{p.phone}</a>
              {p.email && <a href={`mailto:${p.email}`}>{p.email}</a>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container container--narrow center" data-reveal>
      <p class="statement">Sie planen ein Projekt im historischen Bestand?</p>
      <a class="btn btn--light" href="/kontakt">Kontakt aufnehmen</a>
    </div>
  </section>
</BaseLayout>

<style>
  .split {
    display: grid;
    background: var(--c-bg);
  }

  @media (min-width: 64rem) {
    .split {
      grid-template-columns: 1fr 1fr;
      min-height: 40rem;
    }
  }

  .split__media {
    position: relative;
    min-height: 22rem;
  }

  .split__media :global(.bild) {
    position: absolute;
    inset: 0;
  }

  .split__text {
    align-self: center;
    max-width: 36rem;
    padding: var(--space-xl) var(--gutter);
  }

  @media (min-width: 64rem) {
    .split__text {
      padding-inline: var(--space-xl);
    }
  }

  .split__text .btn {
    margin-top: var(--space-s);
  }

  .team__head {
    margin-bottom: var(--space-l);
  }

  .team {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .person {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding: var(--space-l) var(--space-m);
    background: var(--c-white);
    border-top: 2px solid var(--c-navy);
  }

  .person h3 {
    margin-bottom: var(--space-xs);
    font-size: var(--fs-h3);
  }

  .person__role {
    margin: 0;
    color: var(--c-muted);
  }

  .person a {
    text-decoration: none;
  }

  .person a:hover {
    text-decoration: underline;
  }
</style>
