---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ProjektSlider from '@/components/ProjektSlider.astro';
import { site } from '@/data/site';
import { leistungen } from '@/data/leistungen';
import { projekte } from '@/data/projekte';

const startseitenProjekte = projekte.filter((p) => p.startseite);
---

<BaseLayout>
  <Hero
    full
    title="Denkmalgerecht bewahren. Nachhaltig weiterbauen."
    subtitle="Bauforschung | Denkmalpflege | Planung"
    bild="hero-startseite.jpg"
    bildAlt="Blick über die Dächer der Altstadt"
    scrollTo="#ueber"
  >
    <a class="btn btn--light" href="#ueber">Mehr über CONSERVE</a>
  </Hero>

  <!-- Über die CONSERVE -->
  <section id="ueber" class="section">
    <div class="container container--narrow center" data-reveal>
      <span class="eyebrow">Über die CONSERVE</span>
      <h2>Die CONSERVE steht für den verantwortungs&shy;vollen Umgang mit historischer Bausubstanz.</h2>
      <p>
        Seit der Gründung im Jahr {site.founded} widmen wir uns der Erforschung, Bewertung und Weiterentwicklung von
        Baudenkmälern und Bestandsgebäuden. Unser Ziel ist es, die Qualitäten eines Gebäudes sichtbar zu machen und
        daraus tragfähige Grundlagen für Planung, Sanierung und Erhaltung zu entwickeln.
      </p>
      <p>
        Als spezialisiertes Baumeister- und Planungsbüro verbinden wir bauhistorische Forschung, denkmalpflegerische
        Expertise und praktische Sanierungsplanung. Wir betrachten jedes Gebäude in seiner Geschichte, Konstruktion,
        Materialität und Nutzung. So entstehen Lösungen, die den Bestand respektieren, Ressourcen schonen und Gebäude
        zukunftsfähig machen.
      </p>
      <a class="btn ueber__btn" href="/ueber-uns">Mehr über uns</a>
    </div>
  </section>

  <!-- Leistungen -->
  <section class="section section--slate">
    <div class="container leistungen">
      <div class="leistungen__list" data-reveal>
        <span class="eyebrow">Leistungen</span>
        <h2 class="leistungen__title">
          Spezialisiert auf Weltkulturerbe, Denkmalschutz und Altbau – maßgeschneiderte Lösungen für den Erhalt
          historischer Gebäude.
        </h2>
        {
          leistungen.map((bereich) => (
            <div class="bereich">
              <h3>
                <a href={`/leistungen#${bereich.id}`}>{bereich.title}</a>
              </h3>
              <ul>
                {bereich.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="leistungen__aside" data-reveal>
        <p class="statement">
          Fundierte Vor&shy;untersuchung.<br />
          Sichere Planung.<br />
          Nachhaltige Ent&shy;scheidungen.
        </p>
        <a class="btn btn--light" href="/leistungen">Alle Leistungen</a>
      </div>
    </div>
  </section>

  <!-- Projekte -->
  <section class="section section--alt">
    <div class="container">
      <div class="projekte__head" data-reveal>
        <h2>Eine kleine Auswahl unserer Projekte</h2>
        <a class="btn" href="/projekte">Alle Projekte</a>
      </div>
      <ProjektSlider projekte={startseitenProjekte} />
    </div>
  </section>
</BaseLayout>

<style>
  .ueber__btn {
    margin-top: var(--space-m);
  }

  .leistungen {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 64rem) {
    .leistungen {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }

  .leistungen__title {
    font-size: var(--fs-h3);
    line-height: 1.3;
  }

  .bereich {
    padding-top: var(--space-m);
    margin-top: var(--space-m);
    border-top: 1px solid rgb(255 255 255 / 0.3);
  }

  .bereich h3 {
    margin-bottom: var(--space-xs);
    font-size: var(--fs-h3);
    font-weight: 400;
  }

  .bereich h3 a {
    text-decoration: none;
  }

  .bereich h3 a:hover {
    text-decoration: underline;
  }

  .bereich ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  .bereich li {
    padding-block: 0.3rem;
  }

  .leistungen__aside {
    color: var(--c-white);
  }

  @media (min-width: 64rem) {
    .leistungen__aside {
      position: sticky;
      top: 30vh;
      align-self: start;
      margin-top: 30vh;
    }
  }


  .projekte__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-m);
    margin-bottom: var(--space-l);
  }

  .projekte__head h2 {
    margin: 0;
  }
</style>
