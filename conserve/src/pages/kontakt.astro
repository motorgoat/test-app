---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import { site, team, telHref, fullAddress } from '@/data/site';

// Nur ein Link (keine eingebettete Karte) – dadurch keine Cookies und kein Cookie-Banner nötig
const mapsHref = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${site.legalName.replace(/\u00A0/g, ' ')}, ${fullAddress}`)}`;
---

<BaseLayout title="Kontakt" description={`Kontakt zu ${site.legalName}, ${fullAddress}. E-Mail: ${site.email}`}>
  <Hero
    eyebrow="Kontakt"
    title="Sprechen wir über Ihr Gebäude."
    bild="hero-kontakt.jpg"
  />

  <section class="section">
    <div class="container kontakt">
      <div class="kontakt__info" data-reveal>
        <h2 class="eyebrow">Büro Graz</h2>
        <address class="kontakt__adresse">
          {site.legalName}<br />
          {site.address.street}<br />
          A-{site.address.zip} {site.address.city}
        </address>
        <p class="kontakt__links">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          {site.phones.map((nr) => <a href={telHref(nr)}>{nr}</a>)}
        </p>
        <a class="btn" href={mapsHref} target="_blank" rel="noopener noreferrer">
          Route planen<span class="visually-hidden"> (öffnet Google Maps in neuem Tab)</span>
        </a>
      </div>

      <div data-reveal>
        <h2 class="eyebrow">Ansprech&shy;partnerinnen</h2>
        <ul class="list personen">
          {
            team.map((p) => (
              <li>
                <strong>{p.name}</strong>
                {p.role && <span class="personen__role">{p.role}</span>}
                {p.phone && <a href={telHref(p.phone)}>{p.phone}</a>}
                {p.email && <a href={`mailto:${p.email}`}>{p.email}</a>}
                {p.link && (
                  <a href={p.link.href} target="_blank" rel="noopener">
                    {p.link.label}
                    <span class="visually-hidden"> (öffnet in neuem Tab)</span>
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {
    site.formAction && (
      <section class="section section--alt">
        <div class="container container--narrow">
          <h2>Nachricht senden</h2>
          <form class="form" method="post" action={site.formAction}>
            <p class="form__full form__hint">Mit * markierte Felder sind Pflichtfelder.</p>
            <label>
              Name*
              <input name="name" autocomplete="name" required />
            </label>
            <label>
              E-Mail*
              <input name="email" type="email" autocomplete="email" required />
            </label>
            <label>
              Telefon
              <input name="telefon" type="tel" autocomplete="tel" />
            </label>
            <label class="form__full">
              Nachricht*
              <textarea name="nachricht" rows="6" required />
            </label>
            <label class="form__check form__full">
              <input type="checkbox" name="datenschutz" required />
              <span>
                Ich stimme zu, dass meine Angaben zur Bearbeitung der Anfrage verarbeitet werden. Details in der{' '}
                <a href="/datenschutz/">Datenschutzerklärung</a>.*
              </span>
            </label>
            <button class="btn" type="submit">
              Absenden
            </button>
          </form>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .kontakt {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 56rem) {
    .kontakt {
      grid-template-columns: 1fr 1fr;
    }
  }

  .kontakt__adresse {
    margin-bottom: var(--space-m);
    color: var(--c-ink);
    font-family: var(--f-serif);
    font-size: var(--fs-h3);
    font-style: normal;
    line-height: 1.35;
  }

  .kontakt__links {
    display: grid;
    gap: 0.25rem;
    margin-bottom: var(--space-l);
    font-size: var(--fs-lg);
  }

  .personen li {
    display: grid;
    gap: 0.1rem;
    padding-block: var(--space-s);
  }

  .personen li:first-child {
    border-top: 1px solid var(--c-line);
  }

  .personen strong {
    color: var(--c-ink);
    font-weight: 600;
  }

  .personen__role {
    color: var(--c-muted);
  }

  .personen a {
    text-decoration: none;
  }

  .personen a:hover {
    text-decoration: underline;
  }

  .form {
    display: grid;
    gap: var(--space-m);
  }

  @media (min-width: 40rem) {
    .form {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form__full {
    grid-column: 1 / -1;
  }

  .form__hint {
    margin: 0;
    color: var(--c-muted);
    font-size: var(--fs-sm);
  }

  .form label {
    display: grid;
    gap: 0.4rem;
    color: var(--c-ink);
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .form input:not([type='checkbox']),
  .form textarea {
    width: 100%;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--c-muted);
    border-radius: 0;
    background: var(--c-white);
    color: var(--c-ink);
    font: inherit;
    font-size: var(--fs-base);
  }

  .form .form__check {
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.6rem;
    font-weight: 400;
  }

  .form__check input {
    margin-top: 0.35rem;
  }

  .form .btn {
    justify-self: start;
  }
</style>
