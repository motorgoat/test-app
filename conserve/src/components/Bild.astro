---
// Bild aus src/assets/bilder/ – einfach Datei ablegen und den Dateinamen
// als `src` übergeben (z. B. src="hero.jpg"). Astro erzeugt automatisch
// optimierte Größen (WebP). Fehlt die Datei, wird ein gezeichneter
// Platzhalter angezeigt.
// alt="" = rein dekoratives Bild (z. B. wenn daneben ohnehin die Überschrift steht).
// priority = großes Bild ganz oben, wird bevorzugt geladen.
import { Image } from 'astro:assets';
import { findeBild } from '@/lib/bilder';

interface Props {
  src?: string;
  alt: string;
  sizes?: string;
  priority?: boolean;
  class?: string;
}

const { src, alt, sizes = '100vw', priority = false, class: className } = Astro.props;
const image = findeBild(src);

// ---------- Platzhalter: Dachlandschaft mit Kirchturm, je nach Bild variiert ----------
let seed = [...(src || alt)].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
const rand = () => {
  seed = (seed + 0x6d2b79f5) >>> 0;
  let t = seed;
  t = Math.imul(t ^ (t >>> 15), t | 1);
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const between = (min: number, max: number) => Math.round(min + rand() * (max - min));

// Häuser reichen bis zum unteren Bildrand, damit zwischen den Ebenen keine Lücken entstehen
const fenster: string[] = [];
const houses = (top: number, minW: number, maxW: number, minH: number, maxH: number, roof: number, mitFenster = false) => {
  const shapes: string[] = [];
  for (let x = -between(0, maxW); x < 1600; ) {
    const w = between(minW, maxW);
    const h = between(minH, maxH);
    const r = Math.round(w * roof * (0.6 + rand() * 0.5));
    shapes.push(`M${x} 1000V${top - h}L${x + w / 2} ${top - h - r}L${x + w} ${top - h}V1000Z`);
    if (mitFenster) {
      for (let fy = top - h + 34; fy < 990; fy += 62) {
        for (let fx = x + 26; fx < x + w - 36; fx += 46) fenster.push(`M${fx} ${fy}h14v26h-14Z`);
      }
    }
    x += w - between(0, Math.round(w * 0.15));
  }
  return shapes.join('');
};

const spire = (cx: number, base: number, height: number, w: number) => {
  const towerTop = base - height * 0.55;
  return (
    `M${cx - w} ${base}V${towerTop}L${cx - w * 0.75} ${towerTop - 10}H${cx + w * 0.75}L${cx + w} ${towerTop}V${base}Z` +
    `M${cx - w * 0.72} ${towerTop - 8}L${cx} ${base - height}L${cx + w * 0.72} ${towerTop - 8}Z`
  );
};

const shift = between(-260, 260);
const far = houses(640, 40, 90, 10, 60, 0.35);
const mid = houses(730, 90, 170, 40, 110, 0.55);
const near = houses(1000, 200, 340, 150, 260, 0.6, true);
const towers =
  spire(1180 + shift, 700, between(460, 540), 34) + spire(420 - shift / 2, 640, between(150, 210), 12) + spire(880 + shift / 3, 660, 120, 9);
const dome = `M${260 + shift} 640a46 40 0 0 1 92 0Z`;
const apex = between(560, 640);
const front = `M${520 + shift / 2} 1000L${800 + shift / 2} ${apex}L${1080 + shift / 2} 1000Z`;

const uid = `ph${Math.round(rand() * 1e8).toString(36)}`;
const svg = `
<defs>
  <linearGradient id="${uid}s" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#7c8892"/><stop offset=".62" stop-color="#cfd4d6"/><stop offset="1" stop-color="#e3e1dc"/>
  </linearGradient>
  <linearGradient id="${uid}f" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#4a3f39"/><stop offset="1" stop-color="#2b2e33"/>
  </linearGradient>
</defs>
<rect width="1600" height="1000" fill="url(#${uid}s)"/>
<ellipse cx="${560 + shift}" cy="600" rx="520" ry="120" fill="#fff" opacity=".18"/>
<path d="${far}${dome}" fill="#aab2b7"/>
<path d="${towers}" fill="#7a848c"/>
<path d="${mid}" fill="#8a939a"/>
<path d="${near}" fill="#56616b"/>
<path d="${fenster.join('')}" fill="#6b757f"/>
<path d="${front}" fill="url(#${uid}f)"/>
<path d="M${800 + shift / 2} ${apex}V1000" stroke="#1f2328" stroke-width="3" opacity=".35"/>`;
---

{
  image ? (
    <Image
      src={image}
      alt={alt}
      widths={[480, 800, 1200, 1600, 2400]}
      sizes={sizes}
      priority={priority}
      class:list={['bild', className]}
    />
  ) : (
    <svg
      class:list={['bild', 'bild--platzhalter', className]}
      viewBox="0 0 1600 1000"
      preserveAspectRatio="xMidYMax slice"
      role={alt ? 'img' : undefined}
      aria-label={alt || undefined}
      aria-hidden={alt ? undefined : 'true'}
      set:html={svg}
    />
  )
}
