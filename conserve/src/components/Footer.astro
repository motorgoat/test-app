---
import Logo from '@/components/Logo.astro';
import { site, nav, legalNav, telHref } from '@/data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="/" class="footer__logo">
        <Logo variante="monogramm" />
        <span class="visually-hidden">{site.name} – Startseite</span>
      </a>
      <p>{site.claim}</p>
    </div>

    <div>
      <h2 class="footer__title">Kontakt</h2>
      <address>
        {site.legalName}<br />
        {site.address.street}, A-{site.address.zip} {site.address.city}
      </address>
      <p>
        T <a href={telHref(site.phone)}>{site.phone}</a><br />
        M <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>

    <nav aria-label="Footer">
      <h2 class="footer__title">Seiten</h2>
      <ul class="footer__list">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Rechtliches">
      <h2 class="footer__title">Rechtliches</h2>
      <ul class="footer__list">
        {legalNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>

  <div class="container">
    <div class="footer__bottom">
      <span>© {year} {site.name} – Baudenkmalforschung</span>
      <span>{site.taetigkeiten.join(' · ')}</span>
      <span>
        Created by <a class="footer__credit" href="https://www.ident-it.at/" target="_blank" rel="noopener">ident-IT</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-top: var(--space-xl);
    background: var(--c-navy);
    color: rgb(255 255 255 / 0.72);
    font-size: var(--fs-sm);
    line-height: 1.8;
  }

  .footer a {
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer a:hover {
    color: var(--c-white);
  }

  .footer__grid {
    display: grid;
    gap: var(--space-l) var(--space-xl);
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }

  @media (min-width: 64rem) {
    .footer__grid {
      grid-template-columns: 1.2fr 1.8fr 0.8fr 0.8fr;
    }
  }

  .footer__logo {
    display: block;
    height: 3rem;
    margin-bottom: var(--space-m);
    color: var(--c-white);
  }

  .footer__brand p {
    max-width: 16em;
    font-family: var(--f-serif);
    font-size: var(--fs-lg);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .footer__title {
    margin-bottom: var(--space-s);
    color: var(--c-white);
    font-family: var(--f-sans);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  address {
    margin-bottom: var(--space-s);
    font-style: normal;
  }

  .footer__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-m);
    margin-top: var(--space-xl);
    padding-block: var(--space-m);
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    color: rgb(255 255 255 / 0.55);
  }

  .footer__credit {
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.35);
  }
</style>
