---
// Großes Bild mit Text darüber. `full` = volle Bildschirmhöhe (Startseite).
// Im Titel ist HTML erlaubt: <br /> für Zeilenumbrüche, &shy; für Trennstellen.
// Die Unterzeile wird an „|“ in einzelne Begriffe geteilt.
import Bild from '@/components/Bild.astro';

interface Props {
  title: string;
  eyebrow?: string;
  subtitle?: string;
  bild?: string;
  bildAlt?: string; // leer lassen: das Bild ist Hintergrund, die Überschrift trägt die Info
  full?: boolean;
  scrollTo?: string;
}

const { title, eyebrow, subtitle, bild, bildAlt = '', full = false, scrollTo } = Astro.props;
const subItems = subtitle?.split('|').map((s) => s.trim()).filter(Boolean) ?? [];
---

<section class:list={['hero', { 'hero--full': full }]}>
  <div class="hero__media">
    <Bild src={bild} alt={bildAlt} priority />
  </div>
  <div class="container hero__content">
    {eyebrow && <span class="hero__eyebrow">{eyebrow}</span>}
    <h1 class="hero__title" set:html={title} />
    {
      subItems.length > 0 && (
        <p class="hero__subtitle">
          {subItems.map((item) => (
            <span>{item}</span>
          ))}
        </p>
      )
    }
    <slot />
  </div>
  {
    scrollTo && (
      <a href={scrollTo} class="hero__scroll">
        <span class="visually-hidden">Weiter nach unten</span>
        <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
          <path d="M5 9l7 7 7-7" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </a>
    )
  }
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: clamp(26rem, 68svh, 44rem);
    padding-block: calc(var(--header-h) + var(--space-l)) var(--space-xl);
    color: var(--c-white);
    isolation: isolate;
    overflow: hidden;
  }

  .hero--full {
    align-items: center;
    min-height: 100svh;
    text-align: center;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* Abdunkelung, damit weiße Schrift auch auf hellen Fotos lesbar bleibt */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(17 34 54 / 0.6) 0%, rgb(17 34 54 / 0.35) 50%, rgb(17 34 54 / 0.1) 80%),
      linear-gradient(180deg, rgb(17 34 54 / 0.4) 0%, rgb(17 34 54 / 0.3) 40%, rgb(17 34 54 / 0.65) 100%);
  }

  .hero--full .hero__media::after {
    background:
      radial-gradient(ellipse 70% 55% at 50% 52%, rgb(17 34 54 / 0.55), rgb(17 34 54 / 0.3) 100%),
      linear-gradient(180deg, rgb(17 34 54 / 0.4), rgb(17 34 54 / 0.2) 30%, rgb(17 34 54 / 0.2) 70%, rgb(17 34 54 / 0.5));
  }

  .hero__media :global(.bild) {
    animation: hero-zoom 18s var(--ease) both;
  }

  @keyframes hero-zoom {
    from { transform: scale(1.08); }
    to { transform: scale(1); }
  }

  .hero__eyebrow {
    display: block;
    margin-bottom: var(--space-s);
    font-family: var(--f-serif);
    font-size: var(--fs-lg);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-shadow: 0 1px 12px rgb(17 34 54 / 0.6);
  }

  .hero__title {
    max-width: 26ch;
    margin: 0;
    color: var(--c-white);
    font-family: var(--f-serif);
    font-size: clamp(1.5rem, 0.9rem + 3.2vw, 3.75rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-wrap: balance;
    text-shadow: 0 2px 24px rgb(17 34 54 / 0.45);
  }

  /* Titel mit festen Umbrüchen (<br />): volle Breite, nicht zusätzlich ausbalancieren */
  .hero__title:has(br) {
    max-width: none;
    text-wrap: wrap;
  }

  .hero--full .hero__title {
    max-width: none;
    font-size: clamp(1.625rem, 0.6rem + 4.6vw, 5rem);
  }

  .hero__subtitle {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 0.9em;
    margin: var(--space-m) 0 0;
    font-family: var(--f-serif);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-shadow: 0 1px 12px rgb(17 34 54 / 0.6);
  }

  .hero:not(.hero--full) .hero__subtitle {
    justify-content: flex-start;
    align-items: flex-start;
  }

  .hero__subtitle span {
    white-space: nowrap;
  }

  .hero__subtitle span + span::before {
    content: '|';
    margin-right: 0.9em;
    font-weight: 400;
  }

  /* schmale Bildschirme: Begriffe untereinander, ohne Trennstriche */
  @media (max-width: 44.99rem) {
    .hero__subtitle {
      flex-direction: column;
      align-items: center;
    }

    .hero__subtitle span + span::before {
      content: none;
    }
  }

  .hero__content :global(.btn) {
    margin-top: var(--space-l);
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: var(--space-m);
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    translate: -50% 0;
    color: var(--c-white);
    animation: hero-bounce 2.4s var(--ease) infinite;
  }

  @keyframes hero-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }
</style>
