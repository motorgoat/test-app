---
// Bildergalerie mit Großansicht (Lightbox). Ohne JavaScript öffnet ein Klick das Bild direkt.
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  bilder: ImageMetadata[];
  titel: string;
}

const { bilder, titel } = Astro.props;
const gross = await Promise.all(
  bilder.map((b) => getImage({ src: b, width: Math.min(b.width, 2000), format: 'webp' })),
);
---

<ul class="galerie" data-galerie>
  {
    bilder.map((bild, i) => (
      <li class:list={['galerie__item', { 'galerie__item--hoch': bild.height > bild.width }]}>
        <a href={gross[i].src} data-index={i} aria-label={`${titel} – Bild ${i + 1} von ${bilder.length} vergrößern`}>
          <Image src={bild} alt="" widths={[400, 700, 1000]} sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw" />
        </a>
      </li>
    ))
  }
</ul>

<dialog class="lightbox" data-lightbox aria-label={`${titel} – Bildansicht`}>
  <img class="lightbox__bild" alt="" data-lightbox-bild />
  <p class="lightbox__zaehler" data-lightbox-zaehler aria-live="polite"></p>
  <button type="button" class="lightbox__btn lightbox__btn--zu" data-lightbox-zu aria-label="Schließen">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  <button type="button" class="lightbox__btn lightbox__btn--zurueck" data-lightbox-zurueck aria-label="Vorheriges Bild">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
  </button>
  <button type="button" class="lightbox__btn lightbox__btn--weiter" data-lightbox-weiter aria-label="Nächstes Bild">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
  </button>
</dialog>

<script>
  const galerie = document.querySelector<HTMLElement>('[data-galerie]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');

  if (galerie && dialog) {
    const links = [...galerie.querySelectorAll<HTMLAnchorElement>('a[data-index]')];
    const bild = dialog.querySelector<HTMLImageElement>('[data-lightbox-bild]')!;
    const zaehler = dialog.querySelector<HTMLElement>('[data-lightbox-zaehler]')!;
    let aktuell = 0;

    const zeige = (i: number) => {
      aktuell = (i + links.length) % links.length;
      bild.src = links[aktuell].href;
      zaehler.textContent = `${aktuell + 1} / ${links.length}`;
    };

    galerie.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-index]');
      if (!link) return;
      e.preventDefault();
      zeige(Number(link.dataset.index));
      dialog.showModal();
    });

    dialog.querySelector('[data-lightbox-zu]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-zurueck]')!.addEventListener('click', () => zeige(aktuell - 1));
    dialog.querySelector('[data-lightbox-weiter]')!.addEventListener('click', () => zeige(aktuell + 1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') zeige(aktuell - 1);
      if (e.key === 'ArrowRight') zeige(aktuell + 1);
    });
    // Klick neben das Bild schließt
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    // Wischen auf dem Handy
    let startX = 0;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) zeige(aktuell + (dx < 0 ? 1 : -1));
    });
    // Fokus zurück auf das zuletzt geöffnete Bild
    dialog.addEventListener('close', () => links[aktuell]?.focus());
  }
</script>

<style>
  .galerie {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    grid-auto-flow: dense;
    gap: var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .galerie__item a {
    display: block;
    height: 100%;
    overflow: hidden;
    background: var(--c-bg-alt);
  }

  .galerie__item :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.8s var(--ease), opacity 0.3s;
  }

  /* Hochformate über zwei Zeilen; die Zeilenhöhe bestimmen die Querformate */
  .galerie__item--hoch {
    grid-row: span 2;
    min-height: 24rem;
  }

  .galerie__item--hoch a {
    position: relative;
  }

  .galerie__item--hoch :global(img) {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
  }

  .galerie__item a:hover :global(img) {
    transform: scale(1.04);
  }

  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(17 34 54 / 0.96);
    color: var(--c-white);
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox__bild {
    max-width: calc(100vw - 2 * var(--gutter));
    max-height: calc(100dvh - 8rem);
    width: auto;
    height: auto;
    pointer-events: none;
  }

  .lightbox__zaehler {
    position: absolute;
    left: 50%;
    bottom: var(--space-m);
    margin: 0;
    translate: -50% 0;
    font-size: var(--fs-sm);
    letter-spacing: 0.1em;
  }

  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.5);
    background: rgb(17 34 54 / 0.6);
    color: var(--c-white);
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }

  .lightbox__btn:hover {
    border-color: var(--c-white);
    background: var(--c-navy);
  }

  .lightbox__btn:focus-visible {
    outline-color: var(--c-white);
  }

  .lightbox__btn svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .lightbox__btn--zu {
    top: var(--space-s);
    right: var(--space-s);
  }

  .lightbox__btn--zurueck,
  .lightbox__btn--weiter {
    top: 50%;
    translate: 0 -50%;
  }

  .lightbox__btn--zurueck {
    left: var(--space-s);
  }

  .lightbox__btn--weiter {
    right: var(--space-s);
  }

  @media (max-width: 40rem) {
    .lightbox__btn--zurueck,
    .lightbox__btn--weiter {
      top: auto;
      bottom: var(--space-s);
      translate: none;
    }
  }
</style>
