---
// Monogramm „CO“ nach dem Entwurf – bei Vorliegen durch das Original-SVG ersetzen.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class:list={['logo', className]} viewBox="0 0 108 64" aria-hidden="true" focusable="false">
  <path d="M46.5 14.2A26 26 0 1 0 46.5 49.8" fill="none" stroke="currentColor" stroke-width="2.4" />
  <ellipse cx="72" cy="32" rx="22" ry="27" fill="none" stroke="currentColor" stroke-width="2.4" />
</svg>

<style>
  .logo {
    width: auto;
    height: 100%;
  }
</style>
