---
// Original-Logo als SVG (public/logo/). variante: "monogramm" = nur „CO“, "wortmarke" = CONSERVE Baudenkmalforschung OG.
// farbe: "weiss" für dunklen Hintergrund, "dunkel" für hellen.
interface Props {
  variante?: 'monogramm' | 'wortmarke';
  farbe?: 'weiss' | 'dunkel';
  class?: string;
}

const { variante = 'monogramm', farbe = 'weiss', class: className } = Astro.props;
const datei = variante === 'monogramm' ? 'co-monogramm' : 'conserve-wortmarke';
const masse = variante === 'monogramm' ? { width: 192, height: 114 } : { width: 325, height: 77 };
---

<img class:list={['logo', className]} src={`/logo/${datei}-${farbe}.svg`} alt="" {...masse} />

<style>
  .logo {
    width: auto;
    height: 100%;
  }
</style>
