---
import Bild from '@/components/Bild.astro';
import { projektLink, type Projekt } from '@/data/projekte';

interface Props {
  projekt: Projekt;
  sizes?: string;
}

const { projekt, sizes = '(min-width: 64rem) 33vw, 85vw' } = Astro.props;
const { titel, ort, jahr, leistungen, text, bild, bildAlt } = projekt;
const link = projektLink(projekt);
const meta = [ort, jahr].filter(Boolean).join(' · ');
---

<article class:list={['karte', { 'karte--link': link }]}>
  <div class="karte__media">
    <Bild src={bild} alt={bildAlt ?? ''} sizes={sizes} />
  </div>
  <div class="karte__body">
    {meta && <p class="karte__ort">{meta}</p>}
    <h3 class="karte__titel">
      {link ? <a href={link}>{titel}</a> : titel}
    </h3>
    <p class="karte__leistungen">{leistungen}</p>
    {text && <p class="karte__text">{text}</p>}
  </div>
</article>

<style>
  .karte {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: end;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    color: var(--c-white);
    background: var(--c-slate);
    isolation: isolate;
  }

  .karte__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .karte__media :global(.bild) {
    transition: transform 1.2s var(--ease);
  }

  .karte:hover .karte__media :global(.bild) {
    transform: scale(1.05);
  }

  .karte__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 15%, rgb(17 34 54 / 0.55) 45%, rgb(17 34 54 / 0.9) 100%);
  }

  .karte__body {
    padding: clamp(1rem, 0.6rem + 1.5vw, 1.5rem);
  }

  .karte__ort {
    margin-bottom: 0.25rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* ganze Karte klickbar, Link bleibt im Titel (für Screenreader) */
  .karte__titel a {
    text-decoration: none;
  }

  .karte__titel a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .karte--link:hover .karte__titel a,
  .karte__titel a:focus-visible {
    text-decoration: underline;
  }

  .karte__titel a:focus-visible {
    outline: none;
  }

  .karte:has(a:focus-visible) {
    outline: 2px solid var(--c-ink);
    outline-offset: 4px;
  }

  .karte__titel {
    margin-bottom: 0.4rem;
    color: var(--c-white);
    font-size: clamp(1.125rem, 0.7rem + 1.1vw, 1.625rem);
  }

  .karte__leistungen,
  .karte__text {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  .karte__text {
    display: -webkit-box;
    margin-top: 0.5rem;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
</style>
