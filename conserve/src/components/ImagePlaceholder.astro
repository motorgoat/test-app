---
// Neutraler Bildplatzhalter, solange keine Projektfotos eingebunden sind.
interface Props {
  label?: string;
  ratio?: string;
}

const { label = '', ratio = '4 / 3' } = Astro.props;
---

<div class="ph" style={`aspect-ratio: ${ratio}`} role="img" aria-label={label ? `Platzhalter: ${label}` : 'Bildplatzhalter'}>
  <svg viewBox="0 0 120 80" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
    <path d="M20 70V34L60 12l40 22v36" fill="none" stroke="currentColor" stroke-width="1.2" />
    <path d="M14 70h92M34 70V44h14v26M72 44h14v12H72z" fill="none" stroke="currentColor" stroke-width="1.2" />
  </svg>
</div>

<style>
  .ph {
    display: grid;
    place-items: center;
    width: 100%;
    background:
      repeating-linear-gradient(135deg, transparent 0 10px, rgb(140 90 60 / 0.05) 10px 11px),
      #ebe4d8;
    color: #b9ab97;
  }

  svg {
    width: 38%;
    max-width: 10rem;
  }
</style>
