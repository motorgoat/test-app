---
import { site } from '@/data/site';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Sie planen ein Projekt mit historischem Bestand?',
  text = 'Wir begleiten Sie von der bauhistorischen Untersuchung bis zur örtlichen Bauaufsicht. Nehmen Sie per E-Mail oder Telefon Kontakt mit uns auf.',
} = Astro.props;
---

<section class="section section--surface cta">
  <div class="container cta__inner">
    <div>
      <h2>{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="cta__actions">
      <a class="btn" href="/kontakt">Kontakt aufnehmen</a>
      <a class="btn btn--ghost" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</section>

<style>
  .cta__inner {
    display: grid;
    gap: var(--space-l);
    align-items: end;
  }

  @media (min-width: 56rem) {
    .cta__inner {
      grid-template-columns: 1.6fr 1fr;
    }

    .cta__actions {
      justify-content: flex-end;
    }
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .lead {
    margin: 0;
  }
</style>
