+const Flora = preload("res://lookdev/flora.gd")
+static var detail_tex: Texture2D
+
+
+## LOOKDEV: Spielzeugfarben -> natürlichere Töne (weniger Sättigung, etwas dunkler, Grün Richtung Oliv).
+static func real_color(c: Color) -> Color:
+	var h := c.h
+	var s := c.s
+	var v := c.v
+	if h > 0.17 and h < 0.45:          # Grün
+		h = lerpf(h, 0.24, 0.4)
+		s *= 0.72
+		v *= 0.72
+	elif h > 0.5 and h < 0.7:          # Blau (Glas, Kleidung)
+		s *= 0.55
+		v *= 0.8
+	else:
+		s *= 0.68
+		v *= 0.9
+	return Color.from_hsv(h, s, v, c.a)
